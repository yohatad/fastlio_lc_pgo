Panels:
  - Class: rviz_common/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Raw (FAST-LIO)1
        - /Loop Closure (PGO)1
        - /Camera1
        - /Camera1/Visibility1
